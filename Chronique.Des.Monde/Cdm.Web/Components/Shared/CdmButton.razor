@using MudBlazor

@* Bouton D&D avec variantes thématiques *@
<MudButton Variant="@GetVariant()" 
           Color="@GetColor()" 
           Size="@Size"
           StartIcon="@StartIcon"
           EndIcon="@EndIcon"
           Disabled="@Disabled"
           Class="@($"cdm-button cdm-button-{ButtonType.ToString().ToLower()} {Class}")"
           OnClick="@OnClick">
    @if (ChildContent != null)
    {
        @ChildContent
    }
    else
    {
        @Text
    }
</MudButton>

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public CdmButtonType ButtonType { get; set; } = CdmButtonType.Primary;
    [Parameter] public Size Size { get; set; } = Size.Medium;
    [Parameter] public string? StartIcon { get; set; }
    [Parameter] public string? EndIcon { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    
    private Variant GetVariant() => ButtonType switch
    {
        CdmButtonType.Primary => Variant.Filled,
        CdmButtonType.Secondary => Variant.Outlined,
        CdmButtonType.Danger => Variant.Filled,
        CdmButtonType.Success => Variant.Filled,
        CdmButtonType.Ghost => Variant.Text,
        _ => Variant.Filled
    };
    
    private Color GetColor() => ButtonType switch
    {
        CdmButtonType.Primary => Color.Primary,
        CdmButtonType.Secondary => Color.Secondary,
        CdmButtonType.Danger => Color.Error,
        CdmButtonType.Success => Color.Success,
        CdmButtonType.Ghost => Color.Default,
        _ => Color.Primary
    };
}

@* Énumération pour les types de boutons D&D *@
@code {
    public enum CdmButtonType
    {
        Primary,    // Rouge sang - Actions principales
        Secondary,  // Or ancien - Actions importantes
        Danger,     // Rouge vif - Actions dangereuses
        Success,    // Vert forêt - Actions positives
        Ghost       // Transparent - Actions secondaires
    }
}