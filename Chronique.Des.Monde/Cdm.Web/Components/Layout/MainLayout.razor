@using MudBlazor
@inherits LayoutComponentBase
@* Temporary: Comment out auth for demo
@using Cdm.Web.Services.Authentication
*@
@inject IThemeService ThemeService

<MudLayout>
    @* 🔧 TEMPORARY: Always show authenticated layout for demo *@
    @* @if (AuthService.IsAuthenticated) *@
    @if (true)
    {
        @* 🏰 AppBar avec thème D&D *@
        <MudAppBar Elevation="2" Class="cdm-appbar">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" 
                          Color="Color.Inherit" 
                          Edge="Edge.Start" 
                          OnClick="@ToggleDrawer" />
            
            <MudSpacer />
            
            <div class="cdm-appbar-brand">
                <img src="/Icons/Icon_cdm.webp" alt="CDM" class="cdm-appbar-logo" />
                <MudText Typo="Typo.h6" Class="cdm-appbar-title">Chronique des Mondes</MudText>
            </div>
            
            <MudSpacer />
            
            @* 🌙 Bouton de basculement de thème *@
            <MudIconButton Icon="@(ThemeService.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                          Color="Color.Inherit"
                          OnClick="@ToggleTheme"
                          Title="@(ThemeService.IsDarkMode ? "Mode Clair" : "Mode Sombre")" />
            
            @* 👤 Menu utilisateur - Temporary demo user *@
            <MudMenu Icon="@Icons.Material.Filled.AccountCircle" 
                    Color="Color.Inherit" 
                    AnchorOrigin="Origin.BottomLeft"
                    TransformOrigin="Origin.TopLeft">
                <MudMenuItem>
                    <div class="cdm-user-info">
                        <MudText Typo="Typo.body2">🎨 Mode Démo - Design System</MudText>
                    </div>
                </MudMenuItem>
                <MudDivider />
                <MudMenuItem>
                    <MudButton Variant="Variant.Text" 
                              Color="Color.Info"
                              StartIcon="@Icons.Material.Filled.Palette"
                              FullWidth="true"
                              Href="/design-system">
                        Voir Design System
                    </MudButton>
                </MudMenuItem>
            </MudMenu>
        </MudAppBar>

        @* 🏰 Drawer (Menu latéral) avec style D&D *@
        <MudDrawer @bind-Open="@_drawerOpen" 
                   ClipMode="DrawerClipMode.Always" 
                   Elevation="2"
                   Class="cdm-drawer">
            <CdmNavMenu />
        </MudDrawer>

        @* 📜 Contenu principal *@
        <MudMainContent Class="cdm-main-content">
            <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="pa-4">
                @Body
            </MudContainer>
        </MudMainContent>
    }
    else
    {
        @* 🗡️ Layout pour pages d'authentification *@
        <div class="cdm-auth-layout">
            @Body
        </div>
    }
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task ToggleTheme()
    {
        await ThemeService.ToggleDarkModeAsync();
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        ThemeService.ThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.ThemeChanged -= OnThemeChanged;
    }
}
