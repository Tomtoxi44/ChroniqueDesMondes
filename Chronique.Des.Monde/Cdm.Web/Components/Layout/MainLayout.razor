@using MudBlazor
@inherits LayoutComponentBase

<div class="cdm-layout">
    <MudLayout>
        
        @* AppBar moderne *@
        <MudAppBar Elevation="0" Class="cdm-appbar">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" 
                          Color="Color.Inherit" 
                          Edge="Edge.Start" 
                          OnClick="@ToggleDrawer" />
            
            <MudText Typo="Typo.h6" Class="ml-3">
                Chronique des Mondes
            </MudText>
            
            <MudSpacer />
            
            @* User info simple *@
            <MudChip Icon="@Icons.Material.Filled.Person" Color="Color.Primary" Variant="Variant.Text">
                Utilisateur
            </MudChip>

        </MudAppBar>

        @* Drawer avec navigation simple *@
        <MudDrawer @bind-Open="@_drawerOpen" 
                   ClipMode="DrawerClipMode.Always" 
                   Elevation="0"
                   Class="cdm-drawer">
            
            <div class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-4">Navigation</MudText>
                
                <MudNavMenu>
                    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
                        Accueil
                    </MudNavLink>
                    <MudNavLink Href="/characters" Icon="@Icons.Material.Filled.Person">
                        Personnages
                    </MudNavLink>
                    <MudNavLink Href="/login" Icon="@Icons.Material.Filled.Login">
                        Connexion
                    </MudNavLink>
                </MudNavMenu>
            </div>

        </MudDrawer>

        @* Contenu principal *@
        <MudMainContent Class="cdm-main-content">
            @Body
        </MudMainContent>

    </MudLayout>
</div>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
