@page "/login"
@layout EmptyLayout

<PageTitle>Connexion - Chronique des Mondes</PageTitle>

<div class="login-container">
    <MudPaper Class="login-card" Elevation="8">
        
        <div class="text-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.AutoStories" 
                    Style="font-size: 4rem; color: #4A90E2; margin-bottom: 16px;" />
            <MudText Typo="Typo.h4" Style="font-weight: 300; margin-bottom: 8px;">
                Chronique des Mondes
            </MudText>
            <MudText Typo="Typo.body1" Style="color: #B0B0B0;">
                Connectez-vous à votre compte
            </MudText>
        </div>

        <EditForm Model="@_loginModel" OnValidSubmit="@HandleLogin">
            <DataAnnotationsValidator />
            
            <MudTextField @bind-Value="_loginModel.Email"
                         Label="Email"
                         Variant="Variant.Outlined"
                         InputType="InputType.Email"
                         Icon="@Icons.Material.Filled.Email"
                         Required="true"
                         Class="mb-4" />
            
            <MudTextField @bind-Value="_loginModel.Password"
                         Label="Mot de passe"
                         Variant="Variant.Outlined"
                         InputType="InputType.Password"
                         Icon="@Icons.Material.Filled.Lock"
                         Required="true"
                         Class="mb-6" />

            <MudButton ButtonType="ButtonType.Submit"
                      Variant="Variant.Filled"
                      Color="Color.Primary"
                      FullWidth="true"
                      Size="Size.Large"
                      StartIcon="@Icons.Material.Filled.Login"
                      Class="mb-4">
                Se Connecter
            </MudButton>

        </EditForm>

        <MudDivider Class="my-4" />

        <div class="text-center">
            <MudText Typo="Typo.body2" Style="color: #666;">
                Données fictives pour démonstration
            </MudText>
            <MudText Typo="Typo.caption" Style="color: #666;">
                Utilisez n'importe quel email/mot de passe
            </MudText>
        </div>

        <div class="mt-4 text-center">
            <MudButton Href="/" 
                      Variant="Variant.Text" 
                      Color="Color.Secondary"
                      StartIcon="@Icons.Material.Filled.ArrowBack">
                Retour à l'accueil
            </MudButton>
        </div>

    </MudPaper>
</div>

@code {
    private LoginModel _loginModel = new();

    private async Task HandleLogin()
    {
        // Simulation - accepte toute combinaison
        await Task.Delay(500); // Simulation latence
        
        // Redirection vers l'accueil
        Navigation.NavigateTo("/");
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "L'email est requis")]
        [EmailAddress(ErrorMessage = "Format d'email invalide")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Le mot de passe est requis")]
        [MinLength(4, ErrorMessage = "Au moins 4 caractères")]
        public string Password { get; set; } = "";
    }
}

@inject NavigationManager Navigation