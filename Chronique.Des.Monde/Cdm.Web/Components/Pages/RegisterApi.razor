@page "/register"
@layout EmptyLayout
@using Cdm.Web.Models.Api
@using Cdm.Web.Services.Authentication
@inject IJwtAuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Inscription - Chronique des Mondes</PageTitle>

<div class="login-container">
    <MudPaper Class="login-card" Elevation="10">
        
        @* Logo/Titre *@
        <div class="text-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.AutoStories" 
                    Style="font-size: 3rem; color: #4A90E2; margin-bottom: 16px;" />
            <MudText Typo="Typo.h4" Class="mb-2">
                Chronique des Mondes
            </MudText>
            <MudText Typo="Typo.body1" Style="color: #B0B0B0;">
                Créez votre compte aventurier
            </MudText>
        </div>

        @* Formulaire d'inscription *@
        <EditForm Model="@_registerModel" OnValidSubmit="@HandleRegister">
            <DataAnnotationsValidator />
            
            @* Champ Nom d'utilisateur *@
            <MudTextField @bind-Value="_registerModel.UserName"
                         Label="Nom d'utilisateur"
                         Variant="Variant.Outlined"
                         FullWidth="true"
                         Class="mb-4"
                         For="@(() => _registerModel.UserName)"
                         StartIcon="@Icons.Material.Filled.Person" />

            @* Champ Email *@
            <MudTextField @bind-Value="_registerModel.Email"
                         Label="Adresse email"
                         Variant="Variant.Outlined"
                         FullWidth="true"
                         Class="mb-4"
                         InputType="InputType.Email"
                         For="@(() => _registerModel.Email)"
                         StartIcon="@Icons.Material.Filled.Email" />

            @* Champ Mot de passe *@
            <MudTextField @bind-Value="_registerModel.Password"
                         Label="Mot de passe"
                         Variant="Variant.Outlined"
                         FullWidth="true"
                         Class="mb-4"
                         InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                         For="@(() => _registerModel.Password)"
                         StartIcon="@Icons.Material.Filled.Lock"
                         EndIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                         OnEndIconClick="@(() => _showPassword = !_showPassword)" />

            @* Champ Confirmation mot de passe *@
            <MudTextField @bind-Value="_registerModel.ConfirmPassword"
                         Label="Confirmer le mot de passe"
                         Variant="Variant.Outlined"
                         FullWidth="true"
                         Class="mb-4"
                         InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                         For="@(() => _registerModel.ConfirmPassword)"
                         StartIcon="@Icons.Material.Filled.Lock" />

            @* Messages d'erreur/succès *@
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">
                    @_errorMessage
                </MudAlert>
            }

            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <MudAlert Severity="Severity.Success" Class="mb-4">
                    @_successMessage
                </MudAlert>
            }

            @* Bouton d'inscription *@
            <MudButton ButtonType="ButtonType.Submit"
                      Variant="Variant.Filled"
                      Color="Color.Primary"
                      FullWidth="true"
                      Size="Size.Large"
                      Class="mb-4"
                      Disabled="@_isLoading"
                      StartIcon="@(_isLoading ? Icons.Material.Filled.HourglassTop : Icons.Material.Filled.PersonAdd)">
                
                @if (_isLoading)
                {
                    <span>Création en cours...</span>
                }
                else
                {
                    <span>Créer le compte</span>
                }
            </MudButton>

        </EditForm>

        @* Lien vers la connexion *@
        <div class="text-center mt-4">
            <MudText Typo="Typo.body2" Style="color: #B0B0B0;">
                Déjà un compte ?
                <MudLink Href="/login" Color="Color.Primary">
                    Se connecter
                </MudLink>
            </MudText>
        </div>

        @* Informations de test (pour la démo) *@
        <MudDivider Class="my-4" />
        <MudAlert Severity="Severity.Info" Dense="true">
            <MudText Typo="Typo.caption">
                <strong>Test API :</strong> L'inscription crée un compte temporaire pour tester l'intégration backend.
            </MudText>
        </MudAlert>

    </MudPaper>
</div>

@code {
    private RegisterModel _registerModel = new();
    private bool _showPassword = false;
    private bool _isLoading = false;
    private string _errorMessage = "";
    private string _successMessage = "";

    protected override async Task OnInitializedAsync()
    {
        // Vérifier si l'utilisateur est déjà connecté
        if (await AuthService.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo("/", replace: true);
        }
    }

    private async Task HandleRegister()
    {
        _isLoading = true;
        _errorMessage = "";
        _successMessage = "";
        StateHasChanged();

        try
        {
            // Validation des mots de passe
            if (_registerModel.Password != _registerModel.ConfirmPassword)
            {
                _errorMessage = "Les mots de passe ne correspondent pas";
                return;
            }

            var request = new RegisterRequest
            {
                UserName = _registerModel.UserName,
                Email = _registerModel.Email,
                Password = _registerModel.Password
            };

            var response = await AuthService.RegisterAsync(request);

            if (response.Success)
            {
                _successMessage = "Compte créé avec succès ! Redirection...";
                Snackbar.Add("✅ Compte créé avec succès !", Severity.Success);
                
                StateHasChanged();
                await Task.Delay(1500); // Petit délai pour l'UX
                
                Navigation.NavigateTo("/", replace: true);
            }
            else
            {
                _errorMessage = response.Error ?? "Erreur lors de la création du compte";
                Snackbar.Add($"❌ {_errorMessage}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Une erreur technique s'est produite";
            Snackbar.Add("💥 Erreur technique", Severity.Error);
            Console.WriteLine($"Erreur registration: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    public class RegisterModel
    {
        [Required(ErrorMessage = "Le nom d'utilisateur est requis")]
        [StringLength(50, MinimumLength = 3, ErrorMessage = "Le nom d'utilisateur doit contenir entre 3 et 50 caractères")]
        public string UserName { get; set; } = "";

        [Required(ErrorMessage = "L'adresse email est requise")]
        [EmailAddress(ErrorMessage = "Format d'email invalide")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Le mot de passe est requis")]
        [StringLength(100, MinimumLength = 6, ErrorMessage = "Le mot de passe doit contenir au moins 6 caractères")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "La confirmation du mot de passe est requise")]
        public string ConfirmPassword { get; set; } = "";
    }
}