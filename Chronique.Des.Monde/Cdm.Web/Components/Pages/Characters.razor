    private string GetRaceIcon(string race) => race switch
    {
        "Nain" => Icons.Material.Filled.Terrain,
        "Elfe" => Icons.Material.Filled.Park,
        "Humain" => Icons.Material.Filled.Person,
        "Halfelin" => Icons.Material.Filled.Home,
        "Demi-Orc" => Icons.Material.Filled.Whatshot,
        "Tieffelin" => Icons.Material.Filled.LocalFireDepartment,
        _ => Icons.Material.Filled.Person
    };

    private Color GetHealthColor(int current, int max)
    {
        var percentage = (double)current / max * 100;
        return percentage switch
        {
            >= 75 => Color.Success,
            >= 50 => Color.Warning,
            >= 25 => Color.Error,
            _ => Color.Error
        };
    }

    public class Character
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Race { get; set; } = "";
        public string Class { get; set; } = "";
        public int Level { get; set; }
        public int HitPoints { get; set; }
        public int MaxHitPoints { get; set; }
        public int ArmorClass { get; set; }
        public int Speed { get; set; }
        public int Strength { get; set; }
        public int Dexterity { get; set; }
        public int Constitution { get; set; }
        public int Intelligence { get; set; }
        public int Wisdom { get; set; }
        public int Charisma { get; set; }
    }
