@page "/characters"

<PageTitle>Personnages - Chronique des Mondes</PageTitle>

<div class="fade-in page-content">

    @* Header avec actions *@
    <div class="d-flex justify-space-between align-center mb-6" style="margin-top: 8px;">
        <div>
            <MudText Typo="Typo.h3" Style="font-weight: 300;">
                Mes Personnages
            </MudText>
            <MudText Typo="Typo.body1" Style="color: #B0B0B0;">
                Gérez vos héros et leurs aventures
            </MudText>
        </div>
        
        <MudButton Variant="Variant.Filled" 
                  Color="Color.Primary" 
                  StartIcon="@Icons.Material.Filled.Add"
                  Size="Size.Large">
            Nouveau Personnage
        </MudButton>
    </div>

    @* Grille des personnages *@
    <MudGrid>
        @foreach (var character in _characters)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Class="character-card">
                    
                    @* Avatar et infos principales *@
                    <div class="d-flex align-center mb-4">
                        <MudAvatar Size="Size.Large" Color="Color.Primary" Style="margin-right: 16px;">
                            @character.Name.Substring(0, 1).ToUpper()
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.h6">@character.Name</MudText>
                            <MudText Typo="Typo.body2" Style="color: #B0B0B0;">
                                @character.Class Niveau @character.Level
                            </MudText>
                        </div>
                    </div>

                    @* Stats principales *@
                    <MudGrid Class="mb-4">
                        <MudItem xs="4">
                            <div class="stat-item">
                                <div class="stat-value">@character.HitPoints</div>
                                <div class="stat-label">PV</div>
                            </div>
                        </MudItem>
                        <MudItem xs="4">
                            <div class="stat-item">
                                <div class="stat-value">@character.ArmorClass</div>
                                <div class="stat-label">CA</div>
                            </div>
                        </MudItem>
                        <MudItem xs="4">
                            <div class="stat-item">
                                <div class="stat-value">@character.Speed</div>
                                <div class="stat-label">Vitesse</div>
                            </div>
                        </MudItem>
                    </MudGrid>

                    @* Caractéristiques *@
                    <MudText Typo="Typo.body2" Class="mb-2" Style="color: #B0B0B0;">
                        Caractéristiques
                    </MudText>
                    <MudGrid Class="mb-4">
                        <MudItem xs="2">
                            <div class="stat-item">
                                <div class="stat-value" style="font-size: 1rem;">@character.Strength</div>
                                <div class="stat-label">FOR</div>
                            </div>
                        </MudItem>
                        <MudItem xs="2">
                            <div class="stat-item">
                                <div class="stat-value" style="font-size: 1rem;">@character.Dexterity</div>
                                <div class="stat-label">DEX</div>
                            </div>
                        </MudItem>
                        <MudItem xs="2">
                            <div class="stat-item">
                                <div class="stat-value" style="font-size: 1rem;">@character.Constitution</div>
                                <div class="stat-label">CON</div>
                            </div>
                        </MudItem>
                        <MudItem xs="2">
                            <div class="stat-item">
                                <div class="stat-value" style="font-size: 1rem;">@character.Intelligence</div>
                                <div class="stat-label">INT</div>
                            </div>
                        </MudItem>
                        <MudItem xs="2">
                            <div class="stat-item">
                                <div class="stat-value" style="font-size: 1rem;">@character.Wisdom</div>
                                <div class="stat-label">SAG</div>
                            </div>
                        </MudItem>
                        <MudItem xs="2">
                            <div class="stat-item">
                                <div class="stat-value" style="font-size: 1rem;">@character.Charisma</div>
                                <div class="stat-label">CHA</div>
                            </div>
                        </MudItem>
                    </MudGrid>

                    @* Informations additionnelles *@
                    <div class="d-flex justify-space-between align-center mb-3">
                        <MudChip Icon="@GetRaceIcon(character.Race)" 
                                Color="Color.Secondary" 
                                Size="Size.Small"
                                Variant="Variant.Text">
                            @character.Race
                        </MudChip>
                        <MudChip Icon="@Icons.Material.Filled.Timeline" 
                                Color="@GetHealthColor(character.HitPoints, character.MaxHitPoints)" 
                                Size="Size.Small"
                                Variant="Variant.Text">
                            @((character.HitPoints * 100 / character.MaxHitPoints).ToString("F0"))% PV
                        </MudChip>
                    </div>

                    @* Actions *@
                    <div class="d-flex justify-space-between">
                        <MudButton Variant="Variant.Text" 
                                  Color="Color.Primary" 
                                  StartIcon="@Icons.Material.Filled.Visibility">
                            Voir
                        </MudButton>
                        <MudButton Variant="Variant.Text" 
                                  Color="Color.Secondary" 
                                  StartIcon="@Icons.Material.Filled.Edit">
                            Modifier
                        </MudButton>
                        <MudButton Variant="Variant.Text" 
                                  Color="Color.Error" 
                                  StartIcon="@Icons.Material.Filled.Delete">
                            Supprimer
                        </MudButton>
                    </div>

                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    @* Message si aucun personnage *@
    @if (!_characters.Any())
    {
        <MudPaper Class="pa-8 text-center" Elevation="2">
            <MudIcon Icon="@Icons.Material.Filled.PersonOff" 
                    Style="font-size: 4rem; color: #666; margin-bottom: 16px;" />
            <MudText Typo="Typo.h5" Class="mb-2">Aucun personnage</MudText>
            <MudText Typo="Typo.body1" Style="color: #B0B0B0;" Class="mb-4">
                Créez votre premier héros pour commencer l'aventure
            </MudText>
            <MudButton Variant="Variant.Filled" 
                      Color="Color.Primary" 
                      StartIcon="@Icons.Material.Filled.Add">
                Créer un Personnage
            </MudButton>
        </MudPaper>
    }

</div>

